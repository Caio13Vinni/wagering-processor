{
  "name": "wagering-processor",
  "version": "0.1.0",
  "description": "Distributed wagering transaction processor with ledger-based accounting, idempotency and at-least-once messaging guarantees",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "setup:queues": "bun scripts/setup-queues.ts",
    "start": "bun run src/main.ts",
    "migration:create": "bun run scripts/migration-create.ts",
    "migration:up": "bun run scripts/migration-up.ts",
    "migration:down": "bun run scripts/migration-down.ts",
    "test:load": "bun scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": ["./src/config/mikro-orm.config.ts"]
  }
}